# MODELO DE PRODUÇÃO — não copie inteiro para o dev.
# Em desenvolvimento, crie um .env.local só com as chaves que quiser testar
# (ex.: GROQ_API_KEY) e NÃO defina DATABASE_URL nem NODE_ENV: sem elas o dev
# usa o PGlite embutido (.data/pglite) e sobe front+API separados.

# Porta do servidor (produção serve front + API na mesma porta)
PORT=5192

# Conexão Postgres (produção). Sem essa variável, o dev local usa PGlite
# (Postgres embutido, salvo em .data/pglite) — nada para instalar.
DATABASE_URL=postgres://agendamestre:CHANGE_ME@db:5432/agendamestre

# production | development
NODE_ENV=production

# Transcrição por voz (Groq Cloud — https://console.groq.com/keys)
# Modelo padrão: whisper-large-v3-turbo (US$ 0,04/hora de áudio).
# Sem a chave, o app funciona normalmente; só o ditado fica desativado.
GROQ_API_KEY=
# GROQ_STT_MODEL=whisper-large-v3-turbo

# ---- Notificações (lembretes por e-mail e WhatsApp) ----
# WhatsApp via Evolution GO v3 (uma instância por usuário, vinculada por QR)
EVOLUTION_BASE_URL=https://seu-servidor-evolution.exemplo.com.br
EVOLUTION_API_KEY=
# E-mail via Resend (https://resend.com) — o "from" precisa de domínio verificado
RESEND_API_KEY=
RESEND_FROM="AgendaMestre <lembretes@seudominio.com.br>"
# Remetente dos e-mails de conta (recuperação de senha etc.)
RESEND_FROM_AUTH="AgendaMestre <no-reply@seudominio.com.br>"

# Login com Google (opcional — o botão só ativa com os 2 abaixo + APP_URL;
# redirect URI no console: https://agenda.seudominio.com.br/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URL pública do app (vira o link nas mensagens)
APP_URL=https://agenda.seudominio.com.br
# Ajustes do worker e limites de segurança (opcionais — ver docs/mensageria.md)
# NOTIFY_TICK_MS=45000
# NOTIFY_DISABLED=1
# NOTIFY_TICK_CHANNEL_MAX=10      # envios por canal por tick
# NOTIFY_WA_WINDOW_MAX=6          # WhatsApps por usuário por minuto
# NOTIFY_WA_DAILY_CAP=250         # WhatsApps por usuário por 24h
# NOTIFY_WA_GAP_MS=1500           # pausa entre WhatsApps (anti-bloqueio)
# NOTIFY_EMAIL_WINDOW_MAX=10
# NOTIFY_EMAIL_DAILY_CAP=80
# NOTIFY_EMAIL_GLOBAL_CAP=95     # teto do sistema/24h (cota Resend free=100)
# NOTIFY_PENDING_MAX=60
